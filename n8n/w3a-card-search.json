    {
      "parameters": {
        "jsCode": "// Return the top 3 approved cards that match the question, or a clear refusal.\nconst q = $('When Executed by Another Workflow').first().json.query || '';\nconst stop = new Set(['what','when','which','where','does','about','should','would','could','there','their','this','that','with','from','have','engineer','project','learn','learned','lesson','lessons']);\nconst words = q.toLowerCase().split(/\\W+/).filter(w => w.length > 3 && !stop.has(w));\nconst scored = $input.all()\n  .map(i => i.json.data || '')\n  .map(t => ({ t, s: words.filter(w => t.toLowerCase().includes(w)).length }))\n  .filter(x => x.s >= Math.min(2, words.length))\n  .sort((a, b) => b.s - a.s)\n  .slice(0, 3);\nif (!words.length || !scored.length) {\n  return [{ json: { result: 'No approved learning covers this.' } }];\n}\nreturn [{ json: { result: scored.map(x => x.t).join('\\n\\n---\\n\\n') } }];"
      },
